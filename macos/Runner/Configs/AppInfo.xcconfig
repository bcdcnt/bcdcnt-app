// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
// PRODUCT_NAME drives the .app wrapper name (what the Dock/Finder show on hover),
// so it carries the full display title. EXECUTABLE_NAME is pinned to an ASCII
// "bcdcnt" so the Mach-O binary + CFBundleExecutable stay free of spaces/diacritics
// (avoids build-script/codesign edge cases; process name stays "bcdcnt").
PRODUCT_NAME = Bài ca đi cùng năm tháng
EXECUTABLE_NAME = bcdcnt

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = net.bcdcnt.app

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 bcdcnt.net. All rights reserved.
